<Window x:Class="PassKinko.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="パス金庫"
        Width="480" Height="700"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Icon="Assets/app.ico"
        Background="#F3F4F6"
        FontFamily="Yu Gothic UI">
    <Window.Resources>
        <Style TargetType="Button" x:Key="BaseButton">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="10" Margin="8">
        <DockPanel LastChildFill="True">
            <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Background="#FFFFFF">
                <TextBlock x:Name="ScreenTitleTextBlock" Text="" FontSize="23" FontWeight="Bold" Foreground="#111827"/>
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="14,8" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Background="#F9FAFB">
                <TextBlock x:Name="StatusTextBlock" Text="" FontSize="12" Foreground="#2563EB" TextWrapping="Wrap" MinHeight="18"/>
            </Border>

            <Grid Margin="16,12,16,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="RootPanel" />
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</Window>
